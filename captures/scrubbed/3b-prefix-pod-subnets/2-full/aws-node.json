    "ENABLE_MULTI_NIC": "false",
    "ENABLE_POD_ENI": "false",
    "ENABLE_PREFIX_DELEGATION": "true",
    "ENABLE_SUBNET_DISCOVERY": "true",
    "MINIMUM_IP_TARGET": "0",
    "NETWORK_POLICY_ENFORCING_MODE": "standard",
    "VPC_CNI_VERSION": "v1.23.2",
    "VPC_ID": "vpc-EXAMPLE2",
    "WARM_ENI_TARGET": "1",
    "WARM_IP_TARGET": "0",
    "WARM_PREFIX_TARGET": "1"
  }
}
