# Copy to terraform.tfvars (git-ignored) and fill in.

# The account to run the lab in. Terraform refuses to run against any other.
allowed_account_id = "111122223333"

# Your own public address as a /32: curl -s https://checkip.amazonaws.com
admin_cidrs = ["203.0.113.10/32"]

# The current EKS default, printed by scripts/preflight.sh. The lab was run on 1.36.
kubernetes_version = "1.36"
